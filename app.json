{
  "expo": {
    "name": "Heishare",
    "slug": "heishare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heishare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.immz.heishare",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "heishare uses your local network to find and transfer files with nearby devices. Nothing leaves this network.",
        "NSBonjourServices": [
          "_heishare._tcp"
        ]
      }
    },
    "android": {
      "package": "com.immz.heishare",
      "adaptiveIcon": {
        "backgroundColor": "#4A90F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#4A5FE0",
          "dark": {
            "backgroundColor": "#17151F"
          }
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1034df4d-219b-4c7e-93ea-b8b2dd3ff8de"
      }
    },
    "owner": "karimms1620"
  }
}
